IMGFLIP_API=
# Optional: used to shorten prompts longer than 80 characters.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.6-flash.
GEMINI_MODEL=
# Optional: exact HTTPS origin when deploying on a custom domain.
APP_ORIGIN=
# Match service base URL (the app calls POST /match).
MATCH_SERVICE_URL=http://127.0.0.1:8808
# Shared key for the match service. Keep this value server-side.
MATCH_SERVICE_KEY=
# Base URL of match service v2 (Gemini-embedding search) used by the "Situation" and "Photo + situation" modes.
# Must be https unless it is a loopback address. Uses the same MATCH_SERVICE_KEY.
SITUATION_MATCH_URL=
